# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_connectx.db

# JWT Auth (Generate a cryptographically secure random 64-character hex key)
SECRET_KEY=generate-a-strong-random-key-with-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI Providers
AI_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# App Configuration
APP_NAME=AI Connect X
APP_ENV=production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
BACKEND_URL=http://localhost:8000
